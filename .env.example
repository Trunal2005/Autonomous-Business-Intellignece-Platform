# Frontend
VITE_API_BASE_URL=http://localhost:8000
# Set to false to disable login on the frontend (development only).
# Default when unset: true (login required).
VITE_AUTH_REQUIRED=true

# Backend
# Uses the existing stable backend/sem5.db default. Local PostgreSQL remains optional.
DATABASE_URL=sqlite:///./sem5.db
SECRET_KEY=change_this_in_local_dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Auth / RBAC (two roles: admin + analyst, no viewer)
# When true (the default), all protected routers require a valid Bearer token.
AUTH_REQUIRED=true
AUTH_ADMIN_PASSWORD=admin123
AUTH_ANALYST_PASSWORD=analyst123

# Free-only AI: no API key, hosted provider, credits or billing required.
# Only ollama is supported; URLs must use localhost or a literal loopback IP.
# Optional local LLM; numerical calculations always use authorized local data.
# Start/restart the separate Ollama daemon with OLLAMA_NO_CLOUD=1.
# Cloud tags and remote model aliases are refused before sending prompts.
ENABLE_LLM_ASSISTANT=false
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=20

# Dataset ingestion limits (private source bytes are stored in the database)
DATASET_MAX_BYTES=209715200
DATASET_MAX_SPREADSHEET_EXPANDED_BYTES=209715200
DATASET_MAX_ROWS=100000
DATASET_MAX_COLUMNS=100
DATASET_MAX_CELLS=2000000
DATASET_MAX_SECONDS=60

# Bundle budgets are separate from single-file limits. Incoming payload: 200 MiB.
BUNDLE_MAX_EXPANDED_BYTES=536870912
BUNDLE_MAX_TABLE_ROWS=1500000
BUNDLE_MAX_TABLE_CELLS=12000000
BUNDLE_MAX_ROWS=5000000
BUNDLE_MAX_CELLS=40000000
BUNDLE_MAX_SECONDS=900

# Vercel / production (configure privately in Vercel, do not copy dev defaults)
# ENV=production
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
# SECRET_KEY=<unique random value, at least 32 characters>
# AUTH_REQUIRED=true
# ENABLE_LLM_ASSISTANT=false
# Leave VITE_API_BASE_URL UNSET in Vercel for same-origin /api calls.
# CORS_ORIGINS=[]
# VERCEL is supplied by Vercel; do not set it for ordinary local development.
# Private build-time artifact bundle; generated by scripts/package_serving_models.py.
# ML_ARTIFACT_BUNDLE_URL=<private direct HTTPS download URL>
# ML_ARTIFACT_BUNDLE_SHA256=<SHA256 printed by packaging script>
# Bootstrap command ONLY, never required by request handlers:
# BOOTSTRAP_ADMIN_USERNAME=<your private admin username>
# BOOTSTRAP_ADMIN_PASSWORD=<private password, 16 characters to 72 UTF-8 bytes>
